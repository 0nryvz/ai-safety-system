# =========================================================
# CANONICAL LOCAL / MVP RUNTIME CONFIG
# =========================================================

# -------------------------
# Service ports
# -------------------------
BACKEND_PORT=8080
GATEWAY_PORT=8000
AI_WORKER_PORT=8001

# -------------------------
# Shared internal auth
# Backend + Gateway + AI Worker
# MUST use the same value.
# -------------------------
INTERNAL_API_KEY=change-me-local-internal-key

# -------------------------
# Canonical service URLs
# -------------------------
BACKEND_BASE_URL=http://localhost:8080
GATEWAY_BASE_URL=http://localhost:8000
AI_WORKER_BASE_URL=http://localhost:8001

# Backend -> Gateway recording commands
RECORDING_GATEWAY_BASE_URL=http://localhost:8000

# -------------------------
# PostgreSQL
# -------------------------
POSTGRES_DB=isg_db
POSTGRES_USER=isg_user
POSTGRES_PASSWORD=isg_password
POSTGRES_PORT=5432

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/isg_db
SPRING_DATASOURCE_USERNAME=isg_user
SPRING_DATASOURCE_PASSWORD=isg_password

# -------------------------
# MinIO
# Shared by:
# - Docker MinIO
# - Backend playback URL generation
# - Gateway recorder upload
# -------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=violation-media

# -------------------------
# Backend JWT
# Replace outside local/demo.
# -------------------------
JWT_SECRET=development-secret-change-before-production

# -------------------------
# Gateway feature flags
# Canonical values above are used for URLs/keys.
# These flags enable the integrations.
# -------------------------
GATEWAY_AI_HTTP_ENABLED=true
GATEWAY_SESSION_LIFECYCLE_HTTP_ENABLED=true

# -------------------------
# Optional Gateway tuning
# -------------------------
GATEWAY_AI_SAMPLING_FPS=3.0
GATEWAY_AI_DISPATCH_TIMEOUT_SECONDS=1.0
GATEWAY_AI_DISPATCH_MAX_RETRIES=1

# -------------------------
# Recording tuning
# -------------------------
RECORDING_COMMAND_PRE_BUFFER_SECONDS=5
RECORDING_COMMAND_POST_BUFFER_SECONDS=3
RECORDING_COMMAND_MAX_CLIP_SECONDS=30

# -------------------------
# Violation temporal cleanup
# -------------------------
VIOLATION_TEMPORAL_SILENCE_TIMEOUT=5s
VIOLATION_TEMPORAL_SILENCE_SWEEP_INTERVAL=1s

# -------------------------
# Playback
# -------------------------
RECORDING_PLAYBACK_MINIO_EXPIRY=5m