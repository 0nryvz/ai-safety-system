# =========================================================
# CANONICAL LOCAL / MVP RUNTIME CONFIG
# =========================================================

# -------------------------
# Service ports
# -------------------------
BACKEND_PORT=8080
GATEWAY_PORT=8000
AI_WORKER_PORT=8001

# -------------------------
# Shared internal auth
# Backend + Gateway + AI Worker
# MUST use the same value.
# -------------------------
INTERNAL_API_KEY=change-me-local-internal-key

# -------------------------
# Canonical service URLs
# -------------------------
BACKEND_BASE_URL=http://localhost:8080
GATEWAY_BASE_URL=http://localhost:8000
AI_WORKER_BASE_URL=http://localhost:8001

# -------------------------
# AI Worker model/runtime
# -------------------------
# Local AI Worker ai-service klasöründen başlatılır.
AI_MODEL_PATH=./models/best.pt
AI_MODEL_VERSION=best_update_v1
AI_MODEL_METADATA_PATH=./models/model_info.json
AI_MODEL_REQUIRED=true
AI_MODEL_DEVICE=cpu

CONFIDENCE_THRESHOLD=0.50
WELDING_CONFIDENCE_THRESHOLD=0.25
WELDING_MASK_CONFIDENCE_THRESHOLD=0.40
NON_GLOVES_CONFIDENCE_THRESHOLD=0.40
IOU_THRESHOLD=0.45

BACKEND_DETECTIONS_PATH=/internal/v1/detections
BACKEND_REQUEST_TIMEOUT_SECONDS=2.0
AI_CLASS_MAPPING_PATH=config/class_mapping.json

# Backend -> Gateway recording commands
RECORDING_GATEWAY_BASE_URL=http://localhost:8000

# -------------------------
# PostgreSQL
# -------------------------
POSTGRES_DB=isg_db
POSTGRES_USER=isg_user
POSTGRES_PASSWORD=isg_password
POSTGRES_PORT=5432

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/isg_db
SPRING_DATASOURCE_USERNAME=isg_user
SPRING_DATASOURCE_PASSWORD=isg_password

# -------------------------
# MinIO
# Shared by:
# - Docker MinIO
# - Backend internal object access
# - Gateway recorder upload
# - Backend-generated presigned GET URLs (public endpoint)
# -------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Backend / Gateway INTERNAL access to MinIO.
# Used for putObject and other server-side MinIO operations.
MINIO_ENDPOINT=http://localhost:9000

# Browser / physical-mobile presigned GET URL host.
# This is NOT the Gateway upload endpoint.
#
# Local PC-only: localhost is fine, or leave unset.
# When unset/blank the backend falls back to MINIO_ENDPOINT.
#
# Physical phone / wireless demo: set this to the laptop's
# reachable LAN, Mobile Hotspot, or Tailscale address.
#
# Example physical-device demo:
# MINIO_PUBLIC_ENDPOINT=http://192.168.x.x:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=violation-media

# -------------------------
# Backend JWT
# Must be Base64-encoded and decode to at least 32 bytes.
# Replace outside local/demo.
# -------------------------
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# -------------------------
# Backend REST CORS and WebSocket /ws origins
# Comma-separated exact origins. Shared by REST CORS and STOMP handshake.
# Add demo/Tailscale origins as needed.
# Do not use "*" while credentials are enabled.
# -------------------------
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Physical-device / LAN web demo:
# Add the web origin that browsers use to reach the dev server.
# Example:
# APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://192.168.x.x:5173

# -------------------------
# Gateway feature flags
# Canonical values above are used for URLs/keys.
# These flags enable the integrations.
# -------------------------
GATEWAY_AI_HTTP_ENABLED=true
GATEWAY_SESSION_LIFECYCLE_HTTP_ENABLED=true

# -------------------------
# Optional Gateway tuning
# -------------------------
GATEWAY_AI_SAMPLING_FPS=3.0
GATEWAY_AI_DISPATCH_TIMEOUT_SECONDS=1.0
GATEWAY_AI_DISPATCH_MAX_RETRIES=1

# -------------------------
# Recording tuning
# -------------------------
RECORDING_COMMAND_PRE_BUFFER_SECONDS=5
RECORDING_COMMAND_POST_BUFFER_SECONDS=3
RECORDING_COMMAND_MAX_CLIP_SECONDS=30

# -------------------------
# Violation temporal cleanup
# -------------------------
VIOLATION_TEMPORAL_SILENCE_TIMEOUT=5s
VIOLATION_TEMPORAL_SILENCE_SWEEP_INTERVAL=1s

# -------------------------
# Stale session cleanup
# -------------------------
GATEWAY_SESSION_STALE_TIMEOUT_SECONDS=30
GATEWAY_SESSION_CLEANUP_INTERVAL_SECONDS=5

# -------------------------
# Playback
# -------------------------
RECORDING_PLAYBACK_MINIO_EXPIRY=5m