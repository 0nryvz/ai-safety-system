# --- Model (Ultralytics YOLO, imgsz=640, 9 class) ---
AI_MODEL_PATH=./models/best.pt
AI_MODEL_VERSION=ppe-yolo26s-300ep-v1
AI_MODEL_DEVICE=cpu

# --- Inference eşikleri ---
CONFIDENCE_THRESHOLD=0.50
WELDING_CONFIDENCE_THRESHOLD=0.25
NON_GLOVES_CONFIDENCE_THRESHOLD=0.40
IOU_THRESHOLD=0.45

# --- Backend (Spring Boot) ---
BACKEND_BASE_URL=http://localhost:8080
BACKEND_DETECTIONS_PATH=/internal/v1/detections
INTERNAL_API_KEY=changeme
BACKEND_REQUEST_TIMEOUT_SECONDS=2.0

# --- Class mapping ---
AI_CLASS_MAPPING_PATH=config/class_mapping.json